{
	"compilerOptions": {
		"strict": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["bun"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ESNext",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"exclude": ["node_modules"]
}
