{
	"name": "sendenv-platform",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check": "turbo run check",
		"test": "turbo run test",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"sdk:pack": "npm pack ./packages/sdk --dry-run",
		"sdk:publish": "npm publish ./packages/sdk --access public",
		"db:generate": "bun --cwd apps/api run db:generate",
		"db:migrate": "bun --cwd apps/api run db:migrate",
		"db:studio": "bun --cwd apps/api run db:studio"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^9.39.1",
		"@types/bun": "1.4.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "4.1.1",
		"turbo": "2.10.12",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.48.1"
	}
}
